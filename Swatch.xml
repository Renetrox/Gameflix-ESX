		<logoAlignment>center</logoAlignment>
		<logoSize>0.105 0.800</logoSize>
		<logoScale>1.28</logoScale>
		<logoSpacingX>0.105</logoSpacingX>
		<scaledLogoSpacing>0.55</scaledLogoSpacing>

		<!-- Elementos visibles -->
		<maxLogoCount>11</maxLogoCount>
		<minLogoOpacity>0.48</minLogoOpacity>

		<!-- Eleva ligeramente el juego seleccionado -->
		<selectedLogoOffsetY>-0.012</selectedLogoOffsetY>

		<!-- Sin nombre debajo de cada carátula -->
		<carouselShowText>false</carouselShowText>

		<fontPath>./_inc/fonts/NetflixSans-Medium.otf</fontPath>
		<fontSize>0.022</fontSize>

		<zIndex>80</zIndex>
